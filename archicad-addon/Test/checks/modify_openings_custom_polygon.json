{
  "title": "ModifyOpenings resizes and moves the custom openings CreateOpenings makes (#959)",
  "minTapir": "1.7.4",
  "minArchicad": "29",
  "steps": [
    {"id": "wall", "command": "CreateWalls",
     "params": {"wallsData": [{"begCoordinate": {"x": 700, "y": 700}, "endCoordinate": {"x": 708, "y": 700},
                               "zCoordinate": 0, "height": 3.0, "thickness": 0.3}]},
     "save": {"w": "elements[0].elementId.guid"}},
    {"id": "opening in the wall", "command": "CreateOpenings",
     "params": {"openingsData": [{"ownerElementId": {"guid": "${w}"}, "basePoint": {"x": 702, "y": 700, "z": 2.0},
                                  "width": 0.8, "height": 0.6}]},
     "save": {"o": "elements[0].elementId.guid"}},
    {"id": "top center anchor", "command": "SetOpeningDetails", "creates": false,
     "params": {"openingsWithDetails": [{"elementId": {"guid": "${o}"}, "extrusionParameters": {"anchor": "TopCenter"}}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "before", "command": "GetOpeningDetails", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${o}"}}]},
     "save": {"x0": "openings[0].geometry.anchorPoint.x", "z0": "openings[0].geometry.anchorPoint.z"},
     "expect": [{"path": "openings[0].extrusionParameters.shapeType", "eq": "Polygonal", "name": "CreateOpenings makes a custom opening"}]},
    {"id": "resize", "command": "ModifyOpenings", "creates": false,
     "params": {"openingsWithDetails": [{"elementId": {"guid": "${o}"}, "width": 1.1, "height": 0.9}]},
     "expect": [{"path": "executionResults[0].success", "eq": true, "name": "a custom opening is resized"}]},
    {"id": "after the resize", "command": "GetOpeningDetails", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${o}"}}]},
     "save": {"x1": "openings[0].geometry.anchorPoint.x", "z1": "openings[0].geometry.anchorPoint.z",
              "p0x": "openings[0].geometry.polygon[0].x", "p1x": "openings[0].geometry.polygon[1].x",
              "p2x": "openings[0].geometry.polygon[2].x", "p3x": "openings[0].geometry.polygon[3].x",
              "p0y": "openings[0].geometry.polygon[0].y", "p1y": "openings[0].geometry.polygon[1].y",
              "p2y": "openings[0].geometry.polygon[2].y", "p3y": "openings[0].geometry.polygon[3].y"},
     "expect": [{"path": "openings[0].extrusionParameters.shapeType", "eq": "Polygonal"},
                {"path": "openings[0].geometry.polygon", "len": 4},
                {"expr": "${p0x} * ${p0x} + ${p1x} * ${p1x} + ${p2x} * ${p2x} + ${p3x} * ${p3x}", "approx": 1.21, "name": "polygon 1.1 wide (corners at x = +-0.55)"},
                {"expr": "${p0y} * ${p0y} + ${p1y} * ${p1y} + ${p2y} * ${p2y} + ${p3y} * ${p3y}", "approx": 0.81, "name": "polygon 0.9 high (corners at y = +-0.45)"},
                {"expr": "${x1} - ${x0}", "approx": 0.0, "name": "a center anchor stays in place horizontally"},
                {"expr": "${z1} - ${z0}", "approx": 0.3, "name": "the top center anchor rises by the added height, so the bottom edge stays"}]},
    {"id": "3D extent", "command": "Get3DBoundingBoxes", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${o}"}}]},
     "save": {"bxMin": "boundingBoxes3D[0].boundingBox3D.xMin", "bxMax": "boundingBoxes3D[0].boundingBox3D.xMax"},
     "expect": [{"expr": "${bxMax} - ${bxMin}", "approx": 1.1, "name": "the opening is 1.1 wide along the wall"}]},
    {"id": "move", "command": "ModifyOpenings", "creates": false,
     "params": {"openingsWithDetails": [{"elementId": {"guid": "${o}"}, "basePoint": {"x": 705, "y": 700, "z": 2.5}}]},
     "expect": [{"path": "executionResults[0].success", "eq": true, "name": "a custom opening is moved"}]},
    {"id": "after the move", "command": "GetOpeningDetails", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${o}"}}]},
     "save": {"mx": "openings[0].geometry.anchorPoint.x", "my": "openings[0].geometry.anchorPoint.y", "mz": "openings[0].geometry.anchorPoint.z"}},
    {"id": "reference opening at the same base point", "command": "CreateOpenings",
     "params": {"openingsData": [{"ownerElementId": {"guid": "${w}"}, "basePoint": {"x": 705, "y": 700, "z": 2.5},
                                  "width": 1.1, "height": 0.9}]},
     "save": {"r": "elements[0].elementId.guid"}},
    {"id": "reference", "command": "GetOpeningDetails", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${r}"}}]},
     "save": {"rx": "openings[0].geometry.anchorPoint.x", "ry": "openings[0].geometry.anchorPoint.y", "rz": "openings[0].geometry.anchorPoint.z"},
     "expect": [{"expr": "${mx} - ${rx}", "approx": 0.0, "name": "moved where CreateOpenings puts it (x)"},
                {"expr": "${my} - ${ry}", "approx": 0.0, "name": "moved where CreateOpenings puts it (y)"},
                {"expr": "${mz} - ${rz}", "approx": 0.0, "name": "moved where CreateOpenings puts it (z)"}]},
    {"id": "slab", "command": "CreateSlabs",
     "params": {"slabsData": [{"level": 0, "thickness": 0.25, "polygonCoordinates": [
         {"x": 720, "y": 700}, {"x": 726, "y": 700}, {"x": 726, "y": 705}, {"x": 720, "y": 705}]}]},
     "save": {"s": "elements[0].elementId.guid"}},
    {"id": "opening in the slab", "command": "CreateOpenings",
     "params": {"openingsData": [{"ownerElementId": {"guid": "${s}"}, "basePoint": {"x": 723, "y": 702.5, "z": 0.25},
                                  "width": 0.8, "height": 0.6}]},
     "save": {"so": "elements[0].elementId.guid"}},
    {"id": "resize the slab opening", "command": "ModifyOpenings", "creates": false,
     "params": {"openingsWithDetails": [{"elementId": {"guid": "${so}"}, "width": 1.1, "height": 0.9}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "slab opening extent", "command": "Get3DBoundingBoxes", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${so}"}}]},
     "save": {"sxMin": "boundingBoxes3D[0].boundingBox3D.xMin", "sxMax": "boundingBoxes3D[0].boundingBox3D.xMax",
              "syMin": "boundingBoxes3D[0].boundingBox3D.yMin", "syMax": "boundingBoxes3D[0].boundingBox3D.yMax"},
     "expect": [{"expr": "${sxMax} - ${sxMin}", "approx": 1.1, "name": "slab opening 1.1 wide"},
                {"expr": "${syMax} - ${syMin}", "approx": 0.9, "name": "slab opening 0.9 deep"}]},
    {"id": "no fields, and an element that is not an opening", "command": "ModifyOpenings", "creates": false,
     "params": {"openingsWithDetails": [{"elementId": {"guid": "${o}"}}, {"elementId": {"guid": "${w}"}, "width": 1.0}]},
     "expect": [{"path": "executionResults[0].success", "eq": false},
                {"path": "executionResults[1].success", "eq": false}]}
  ]
}
