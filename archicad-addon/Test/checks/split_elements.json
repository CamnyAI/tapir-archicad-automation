{
  "title": "SplitElements splits walls, lines, arcs and polylines; the new pieces keep openings, properties, classifications and the Element ID",
  "minTapir": "1.7.4",
  "steps": [
    {"id": "classification system", "command": "API.GetAllClassificationSystems", "creates": false,
     "save": {"sys": "classificationSystems[0].classificationSystemId.guid"}},
    {"id": "two walls", "command": "CreateWalls",
     "params": {"wallsData": [
       {"begCoordinate": {"x": 700, "y": 700}, "endCoordinate": {"x": 710, "y": 700}, "zCoordinate": 0, "height": 3, "thickness": 0.3},
       {"begCoordinate": {"x": 700, "y": 710}, "endCoordinate": {"x": 710, "y": 710}, "zCoordinate": 0, "height": 3, "thickness": 0.3}]},
     "save": {"w1": "elements[0].elementId.guid", "w2": "elements[1].elementId.guid"}},
    {"id": "a window on each half of wall 1", "command": "CreateWindows",
     "params": {"windowsData": [
       {"ownerWallId": {"guid": "${w1}"}, "centerOffset": 2.0, "width": 1.0, "height": 1.5},
       {"ownerWallId": {"guid": "${w1}"}, "centerOffset": 7.0, "width": 1.0, "height": 1.5}]},
     "expect": [{"path": "elements", "len": 2}]},
    {"id": "wall 1 unclassified (a new wall would get the tool's classification)", "command": "SetClassificationsOfElements", "creates": false,
     "params": {"elementClassifications": [{"elementId": {"guid": "${w1}"}, "classificationId": {"classificationSystemId": {"guid": "${sys}"}}}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "classification of wall 2", "command": "GetClassificationsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w2}"}}], "classificationSystemIds": [{"classificationSystemId": {"guid": "${sys}"}}]},
     "save": {"cls": "elementClassifications[0].classificationIds[0].classificationItemId.guid"}},
    {"id": "property group", "command": "CreatePropertyGroups", "creates": false,
     "params": {"propertyGroups": [{"propertyGroup": {"name": "TapirCheck SplitElements"}}]},
     "save": {"grp": "propertyGroupIds[0].propertyGroupId.guid"}},
    {"id": "property for walls", "command": "CreatePropertyDefinitions", "creates": false,
     "params": {"propertyDefinitions": [{"propertyDefinition": {
       "name": "TapirCheck split text", "description": "", "type": "string", "isEditable": true,
       "defaultValue": {"basicDefaultValue": {"type": "string", "status": "userUndefined"}},
       "group": {"propertyGroupId": {"guid": "${grp}"}},
       "availability": [{"classificationItemId": {"guid": "${cls}"}}]}}]},
     "save": {"prop": "propertyIds[0].propertyId.guid"}},
    {"id": "property value of wall 2", "command": "SetPropertyValuesOfElements", "creates": false,
     "params": {"elementPropertyValues": [{"elementId": {"guid": "${w2}"}, "propertyId": {"guid": "${prop}"}, "propertyValue": {"value": "kept by the piece"}}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "Element ID of wall 2", "command": "SetDetailsOfElements", "creates": false,
     "params": {"elementsWithDetails": [{"elementId": {"guid": "${w2}"}, "details": {"id": "TapirCheck-split"}}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "line, arc and polyline", "command": "CreateLineElements",
     "params": {"linesData": [{"begCoordinate": {"x": 700, "y": 720}, "endCoordinate": {"x": 710, "y": 720}}]},
     "save": {"l1": "elements[0].elementId.guid"}},
    {"id": "arc", "command": "CreateArcs",
     "params": {"arcsData": [{"origin": {"x": 705, "y": 730}, "radius": 3, "begAngle": 0.0, "endAngle": 3.141592653589793}]},
     "save": {"a1": "elements[0].elementId.guid"}},
    {"id": "polyline", "command": "CreatePolylines",
     "params": {"polylinesData": [{"coordinates": [{"x": 700, "y": 740}, {"x": 704, "y": 744}, {"x": 710, "y": 740}]}]},
     "save": {"p1": "elements[0].elementId.guid"}},
    {"id": "split along x = 705", "command": "SplitElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w1}"}}, {"elementId": {"guid": "${w2}"}}, {"elementId": {"guid": "${l1}"}},
                             {"elementId": {"guid": "${a1}"}}, {"elementId": {"guid": "${p1}"}}],
                "splitLine": {"begCoordinate": {"x": 705, "y": 0}, "endCoordinate": {"x": 705, "y": 1000}}},
     "save": {"w1b": "piecesOfElements[0].elements[1].elementId.guid", "w2b": "piecesOfElements[1].elements[1].elementId.guid",
              "l1b": "piecesOfElements[2].elements[1].elementId.guid", "a1b": "piecesOfElements[3].elements[1].elementId.guid",
              "p1b": "piecesOfElements[4].elements[1].elementId.guid"},
     "expect": [{"path": "piecesOfElements[0].elements", "len": 2, "name": "wall: two pieces"},
                {"path": "piecesOfElements[2].elements", "len": 2, "name": "line: two pieces"},
                {"path": "piecesOfElements[3].elements", "len": 2, "name": "arc: two pieces"},
                {"path": "piecesOfElements[4].elements", "len": 2, "name": "polyline: two pieces"}]},
    {"id": "wall pieces", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w1}"}}, {"elementId": {"guid": "${w1b}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.endCoordinate.x", "approx": 705, "tol": 1e-6, "name": "the original ends at the line"},
                {"path": "detailsOfElements[1].details.begCoordinate.x", "approx": 705, "tol": 1e-6, "name": "the new piece starts there"},
                {"path": "detailsOfElements[1].details.endCoordinate.x", "approx": 710, "tol": 1e-6, "name": "and ends where the wall ended"},
                {"path": "detailsOfElements[1].details.height", "approx": 3, "tol": 1e-6},
                {"path": "detailsOfElements[1].details.begThickness", "approx": 0.3, "tol": 1e-6},
                {"path": "detailsOfElements[0].details.hasWindow", "eq": true, "name": "a window stays on the original"},
                {"path": "detailsOfElements[1].details.hasWindow", "eq": true, "name": "a window moved to the new piece"}]},
    {"id": "windows", "command": "GetElementsByType", "creates": false,
     "params": {"elementType": "Window"},
     "save": {"windows": "elements"},
     "expect": [{"path": "elements", "len": 2, "name": "still two windows"}]},
    {"id": "window positions", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": "${windows}"},
     "expect": [{"path": "detailsOfElements[0].details.centerOffset", "approx": 2, "tol": 1e-6},
                {"path": "detailsOfElements[1].details.centerOffset", "approx": 2, "tol": 1e-6, "name": "the moved window sits 2 m from the new piece's start"}]},
    {"id": "property of the new piece", "command": "GetPropertyValuesOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w2b}"}}], "properties": [{"propertyId": {"guid": "${prop}"}}]},
     "expect": [{"path": "propertyValuesForElements[0].propertyValues[0].propertyValue.value", "eq": "kept by the piece"}]},
    {"id": "Element ID of the new piece", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w2b}"}}]},
     "expect": [{"path": "detailsOfElements[0].id", "eq": "TapirCheck-split"}]},
    {"id": "classification of the new piece", "command": "GetClassificationsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w1b}"}}], "classificationSystemIds": [{"classificationSystemId": {"guid": "${sys}"}}]},
     "expect": [{"path": "elementClassifications[0].classificationIds[0].classificationItemId.guid", "eq": "00000000-0000-0000-0000-000000000000", "name": "unclassified like the original, not classified by the tool"}]},
    {"id": "line, arc and polyline pieces", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${l1}"}}, {"elementId": {"guid": "${l1b}"}}, {"elementId": {"guid": "${a1}"}},
                             {"elementId": {"guid": "${a1b}"}}, {"elementId": {"guid": "${p1}"}}, {"elementId": {"guid": "${p1b}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.endCoordinate.x", "approx": 705, "tol": 1e-6},
                {"path": "detailsOfElements[1].details.begCoordinate.x", "approx": 705, "tol": 1e-6},
                {"path": "detailsOfElements[1].details.endCoordinate.x", "approx": 710, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.endAngle", "approx": 1.5707963, "tol": 1e-6, "name": "first arc piece ends at the top"},
                {"path": "detailsOfElements[3].details.begAngle", "approx": 1.5707963, "tol": 1e-6},
                {"path": "detailsOfElements[3].details.endAngle", "approx": 3.1415927, "tol": 1e-6},
                {"path": "detailsOfElements[3].details.radius", "approx": 3, "tol": 1e-6},
                {"path": "detailsOfElements[4].details.coordinates", "len": 3, "name": "first polyline piece keeps the corner"},
                {"path": "detailsOfElements[4].details.coordinates[2].x", "approx": 705, "tol": 1e-6},
                {"path": "detailsOfElements[4].details.coordinates[2].y", "approx": 743.3333333, "tol": 1e-6},
                {"path": "detailsOfElements[5].details.coordinates", "len": 2},
                {"path": "detailsOfElements[5].details.coordinates[1].x", "approx": 710, "tol": 1e-6}]},
    {"id": "a split line that misses the element", "command": "SplitElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${l1}"}}],
                "splitLine": {"begCoordinate": {"x": 800, "y": 0}, "endCoordinate": {"x": 800, "y": 1}}},
     "expect": [{"path": "piecesOfElements[0].error.code", "exists": true}]}
  ],
  "teardown": [
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${w1b}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${w2b}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${l1b}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${a1b}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${p1b}"}}]}},
    {"command": "DeletePropertyDefinitions", "params": {"propertyIds": [{"propertyId": {"guid": "${prop}"}}]}},
    {"command": "DeletePropertyGroups", "params": {"propertyGroupIds": [{"propertyGroupId": {"guid": "${grp}"}}]}}
  ]
}
