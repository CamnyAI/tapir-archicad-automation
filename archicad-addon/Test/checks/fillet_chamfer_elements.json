{
  "title": "FilletElements and ChamferElements round or cut the corner of two walls or two lines",
  "minTapir": "1.7.4",
  "steps": [
    {"id": "two lines meeting in a corner", "command": "CreateLineElements",
     "params": {"linesData": [{"begCoordinate": {"x": 700, "y": 700}, "endCoordinate": {"x": 710, "y": 700}},
                              {"begCoordinate": {"x": 710, "y": 700}, "endCoordinate": {"x": 710, "y": 710}},
                              {"begCoordinate": {"x": 720, "y": 700}, "endCoordinate": {"x": 730, "y": 700}},
                              {"begCoordinate": {"x": 730, "y": 700}, "endCoordinate": {"x": 730, "y": 710}}]},
     "save": {"f1": "elements[0].elementId.guid", "f2": "elements[1].elementId.guid", "c1": "elements[2].elementId.guid", "c2": "elements[3].elementId.guid"}},
    {"id": "two walls meeting in a corner", "command": "CreateWalls",
     "params": {"wallsData": [{"begCoordinate": {"x": 700, "y": 720}, "endCoordinate": {"x": 710, "y": 720}, "zCoordinate": 0, "height": 3, "thickness": 0.3},
                              {"begCoordinate": {"x": 710, "y": 720}, "endCoordinate": {"x": 710, "y": 730}, "zCoordinate": 0, "height": 3, "thickness": 0.3},
                              {"begCoordinate": {"x": 720, "y": 720}, "endCoordinate": {"x": 730, "y": 720}, "zCoordinate": 0, "height": 3, "thickness": 0.3},
                              {"begCoordinate": {"x": 730, "y": 730}, "endCoordinate": {"x": 730, "y": 720}, "zCoordinate": 0, "height": 3, "thickness": 0.3}]},
     "save": {"w1": "elements[0].elementId.guid", "w2": "elements[1].elementId.guid", "w3": "elements[2].elementId.guid", "w4": "elements[3].elementId.guid"}},
    {"id": "fillet", "command": "FilletElements", "creates": false,
     "params": {"elementPairs": [{"elementId1": {"guid": "${f1}"}, "elementId2": {"guid": "${f2}"}, "radius": 2},
                                 {"elementId1": {"guid": "${w1}"}, "elementId2": {"guid": "${w2}"}, "radius": 3},
                                 {"elementId1": {"guid": "${c1}"}, "elementId2": {"guid": "${c2}"}, "radius": 50}]},
     "save": {"arc": "connectingElements[0].elementId.guid", "curvedWall": "connectingElements[1].elementId.guid"},
     "expect": [{"path": "connectingElements[2].error.code", "exists": true, "name": "a radius too large for the elements"}]},
    {"id": "filleted lines and the arc", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${f1}"}}, {"elementId": {"guid": "${f2}"}}, {"elementId": {"guid": "${arc}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.endCoordinate.x", "approx": 708, "tol": 1e-6},
                {"path": "detailsOfElements[1].details.begCoordinate.y", "approx": 702, "tol": 1e-6},
                {"path": "detailsOfElements[2].type", "eq": "Arc"},
                {"path": "detailsOfElements[2].details.origin.x", "approx": 708, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.origin.y", "approx": 702, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.radius", "approx": 2, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.begAngle", "approx": 4.7123890, "tol": 1e-6, "name": "from 270 degrees"},
                {"path": "detailsOfElements[2].details.endAngle", "approx": 0, "tol": 1e-6, "name": "counterclockwise to 0 degrees"}]},
    {"id": "filleted walls and the curved wall", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w1}"}}, {"elementId": {"guid": "${w2}"}}, {"elementId": {"guid": "${curvedWall}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.endCoordinate.x", "approx": 707, "tol": 1e-6},
                {"path": "detailsOfElements[1].details.begCoordinate.y", "approx": 723, "tol": 1e-6},
                {"path": "detailsOfElements[2].type", "eq": "Wall"},
                {"path": "detailsOfElements[2].details.begCoordinate.x", "approx": 707, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.begCoordinate.y", "approx": 720, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.endCoordinate.x", "approx": 710, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.endCoordinate.y", "approx": 723, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.arcAngle", "approx": 1.5707963, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.height", "approx": 3, "tol": 1e-6}]},
    {"id": "chamfer", "command": "ChamferElements", "creates": false,
     "params": {"elementPairs": [{"elementId1": {"guid": "${c1}"}, "elementId2": {"guid": "${c2}"}, "distance1": 2, "distance2": 3},
                                 {"elementId1": {"guid": "${w3}"}, "elementId2": {"guid": "${w4}"}, "distance1": 1},
                                 {"elementId1": {"guid": "${c1}"}, "elementId2": {"guid": "${w3}"}, "distance1": 1}]},
     "save": {"chamferLine": "connectingElements[0].elementId.guid", "chamferWall": "connectingElements[1].elementId.guid"},
     "expect": [{"path": "connectingElements[2].error.code", "exists": true, "name": "a line and a wall"}]},
    {"id": "chamfered elements", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${c1}"}}, {"elementId": {"guid": "${c2}"}}, {"elementId": {"guid": "${chamferLine}"}},
                             {"elementId": {"guid": "${w3}"}}, {"elementId": {"guid": "${w4}"}}, {"elementId": {"guid": "${chamferWall}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.endCoordinate.x", "approx": 728, "tol": 1e-6},
                {"path": "detailsOfElements[1].details.begCoordinate.y", "approx": 703, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.begCoordinate.x", "approx": 728, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.endCoordinate.y", "approx": 703, "tol": 1e-6},
                {"path": "detailsOfElements[3].details.endCoordinate.x", "approx": 729, "tol": 1e-6},
                {"path": "detailsOfElements[4].details.endCoordinate.y", "approx": 721, "tol": 1e-6, "name": "a wall running towards the corner keeps its direction"},
                {"path": "detailsOfElements[5].details.begCoordinate.x", "approx": 729, "tol": 1e-6},
                {"path": "detailsOfElements[5].details.endCoordinate.y", "approx": 721, "tol": 1e-6}]}
  ],
  "teardown": [
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${arc}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${curvedWall}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${chamferLine}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${chamferWall}"}}]}}
  ]
}
