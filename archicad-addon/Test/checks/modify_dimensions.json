{
  "title": "ModifyDimensions changes the appearance and text settings of a dimension in place",
  "minTapir": "1.7.4",
  "steps": [
    {"id": "dimension", "command": "CreateAssociativeDimensions",
     "params": {"dimensionsData": [{"referencePoint": {"x": 960, "y": 938}, "direction": {"x": 1, "y": 0}, "textHeight": 2, "textPen": 3,
                                    "witnessPoints": [{"coordinate": {"x": 960, "y": 940}}, {"coordinate": {"x": 963, "y": 940}}, {"coordinate": {"x": 966, "y": 940}}]}]},
     "save": {"dim": "elements[0].elementId.guid"}},

    {"id": "appearance and text", "command": "ModifyDimensions", "creates": false,
     "params": {"dimensionsWithDetails": [{"elementId": {"guid": "${dim}"}, "textHeight": 4.5, "textPen": 21, "textFrame": true, "linePen": 11,
                                           "markerType": "FullArrow30", "markerPen": 12, "markerSize": 3.0, "witnessForm": "Fix", "witnessVal": 0.5,
                                           "textPosition": "Below"}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "the same dimension, changed", "command": "GetDimensionData", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${dim}"}}]},
     "expect": [{"path": "dimensionsData[0].witnessPoints", "len": 3, "name": "the witness points stay"},
                {"path": "dimensionsData[0].settings.linePen", "eq": 11},
                {"path": "dimensionsData[0].settings.markerType", "eq": "FullArrow30"},
                {"path": "dimensionsData[0].settings.markerPen", "eq": 12},
                {"path": "dimensionsData[0].settings.markerSize", "approx": 3.0},
                {"path": "dimensionsData[0].settings.witnessForm", "eq": "Fix"},
                {"path": "dimensionsData[0].settings.witnessVal", "approx": 0.5},
                {"path": "dimensionsData[0].settings.textPosition", "eq": "Below"},
                {"path": "dimensionsData[0].settings.textHeight", "approx": 4.5},
                {"path": "dimensionsData[0].witnessPoints[0].textHeight", "approx": 4.5, "name": "every witness text changes"},
                {"path": "dimensionsData[0].witnessPoints[2].textHeight", "approx": 4.5},
                {"path": "dimensionsData[0].witnessPoints[2].textPen", "eq": 21},
                {"path": "dimensionsData[0].witnessPoints[1].textFrame", "eq": true},
                {"path": "dimensionsData[0].witnessPoints[1].witnessForm", "eq": "Fix"},
                {"path": "dimensionsData[0].witnessPoints[1].witnessVal", "approx": 0.5},
                {"path": "dimensionsData[0].witnessPoints[2].dimensionValue", "approx": 3.0, "name": "the measured value stays"}]},

    {"id": "dimension line and type", "command": "ModifyDimensions", "creates": false,
     "params": {"dimensionsWithDetails": [{"elementId": {"guid": "${dim}"}, "referencePoint": {"x": 960, "y": 937}, "appearance": "Cumulative"}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "moved line, cumulative values", "command": "GetDimensionData", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${dim}"}}]},
     "expect": [{"path": "dimensionsData[0].dimensionLinePosition.y", "approx": 937},
                {"path": "dimensionsData[0].witnessPoints[0].dimensionPosition.y", "approx": 937},
                {"path": "dimensionsData[0].settings.appearance", "eq": "Cumulative"},
                {"path": "dimensionsData[0].witnessPoints[2].dimensionValue", "approx": 6.0},
                {"path": "dimensionsData[0].settings.textHeight", "approx": 4.5, "name": "the text settings stay"}]},

    {"id": "baseline type", "command": "ModifyDimensions", "creates": false,
     "params": {"dimensionsWithDetails": [{"elementId": {"guid": "${dim}"}, "appearance": "Baseline"}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "baseline values", "command": "GetDimensionData", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${dim}"}}]},
     "expect": [{"path": "dimensionsData[0].settings.appearance", "eq": "Baseline"}]},
    {"id": "back to linear", "command": "ModifyDimensions", "creates": false,
     "params": {"dimensionsWithDetails": [{"elementId": {"guid": "${dim}"}, "appearance": "Linear"}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "linear values", "command": "GetDimensionData", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${dim}"}}]},
     "expect": [{"path": "dimensionsData[0].settings.appearance", "eq": "Linear"},
                {"path": "dimensionsData[0].witnessPoints[2].dimensionValue", "approx": 3.0}]},
    {"id": "not switched to Elevation", "command": "ModifyDimensions", "creates": false,
     "params": {"dimensionsWithDetails": [{"elementId": {"guid": "${dim}"}, "appearance": "Elevation"}]},
     "expect": [{"path": "executionResults[0].success", "eq": false}]},

    {"id": "unknown font", "command": "ModifyDimensions", "creates": false,
     "params": {"dimensionsWithDetails": [{"elementId": {"guid": "${dim}"}, "textFont": "No Such Font 4711"}]},
     "expect": [{"path": "executionResults[0].success", "eq": false}]},
    {"id": "zero direction", "command": "ModifyDimensions", "creates": false,
     "params": {"dimensionsWithDetails": [{"elementId": {"guid": "${dim}"}, "direction": {"x": 0, "y": 0}}]},
     "expect": [{"path": "executionResults[0].success", "eq": false}]},
    {"id": "still there after the refusals", "command": "GetDimensionData", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${dim}"}}]},
     "expect": [{"path": "dimensionsData[0].direction.x", "approx": 1}]}
  ]
}
