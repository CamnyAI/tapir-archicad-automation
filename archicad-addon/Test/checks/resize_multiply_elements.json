{
  "title": "ResizeElements scales elements about a point, MultiplyElements makes stepped copies",
  "minTapir": "1.7.4",
  "steps": [
    {"id": "lines", "command": "CreateLineElements",
     "params": {"linesData": [{"begCoordinate": {"x": 700, "y": 700}, "endCoordinate": {"x": 702, "y": 700}},
                              {"begCoordinate": {"x": 700, "y": 710}, "endCoordinate": {"x": 701, "y": 710}},
                              {"begCoordinate": {"x": 710, "y": 710}, "endCoordinate": {"x": 711, "y": 710}}]},
     "save": {"r": "elements[0].elementId.guid", "m": "elements[1].elementId.guid", "rot": "elements[2].elementId.guid"}},
    {"id": "wall", "command": "CreateWalls",
     "params": {"wallsData": [{"begCoordinate": {"x": 700, "y": 720}, "endCoordinate": {"x": 704, "y": 720}, "zCoordinate": 0, "height": 3, "thickness": 0.3}]},
     "save": {"w": "elements[0].elementId.guid"}},
    {"id": "resize the line", "command": "ResizeElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${r}"}}], "origin": {"x": 700, "y": 700}, "ratio": 2},
     "expect": [{"path": "resizedElements[0].elementId.guid", "exists": true}]},
    {"id": "resized line", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${r}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.begCoordinate.x", "approx": 700, "tol": 1e-6},
                {"path": "detailsOfElements[0].details.endCoordinate.x", "approx": 704, "tol": 1e-6, "name": "twice as long"}]},
    {"id": "a resized copy of the wall", "command": "ResizeElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w}"}}], "origin": {"x": 700, "y": 720}, "ratio": 0.5, "copy": true},
     "save": {"wcopy": "resizedElements[0].elementId.guid"}},
    {"id": "wall and its copy", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w}"}}, {"elementId": {"guid": "${wcopy}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.endCoordinate.x", "approx": 704, "tol": 1e-6, "name": "the original is kept"},
                {"path": "detailsOfElements[1].details.endCoordinate.x", "approx": 702, "tol": 1e-6, "name": "the copy is half as long"}]},
    {"id": "three copies 2 m apart", "command": "MultiplyElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${m}"}}], "numberOfCopies": 3, "moveVector": {"x": 0, "y": 2, "z": 0}},
     "save": {"m1": "copiesOfElements[0].elements[0].elementId.guid", "m2": "copiesOfElements[0].elements[1].elementId.guid", "m3": "copiesOfElements[0].elements[2].elementId.guid"},
     "expect": [{"path": "copiesOfElements[0].elements", "len": 3}]},
    {"id": "two copies rotated by 90 degrees each", "command": "MultiplyElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${rot}"}}], "numberOfCopies": 2, "rotation": {"origin": {"x": 710, "y": 710}, "angle": 1.5707963267948966}},
     "save": {"rot1": "copiesOfElements[0].elements[0].elementId.guid", "rot2": "copiesOfElements[0].elements[1].elementId.guid"},
     "expect": [{"path": "copiesOfElements[0].elements", "len": 2}]},
    {"id": "copies", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${m1}"}}, {"elementId": {"guid": "${m3}"}}, {"elementId": {"guid": "${rot1}"}}, {"elementId": {"guid": "${rot2}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.begCoordinate.y", "approx": 712, "tol": 1e-6},
                {"path": "detailsOfElements[1].details.begCoordinate.y", "approx": 716, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.endCoordinate.x", "approx": 710, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.endCoordinate.y", "approx": 711, "tol": 1e-6},
                {"path": "detailsOfElements[3].details.endCoordinate.x", "approx": 709, "tol": 1e-6},
                {"path": "detailsOfElements[3].details.endCoordinate.y", "approx": 710, "tol": 1e-6}]},
    {"id": "two copies of the wall, each 3 m higher", "command": "MultiplyElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w}"}}], "numberOfCopies": 2, "moveVector": {"x": 0, "y": 0, "z": 3}, "distribute": false},
     "save": {"w1": "copiesOfElements[0].elements[0].elementId.guid", "w2": "copiesOfElements[0].elements[1].elementId.guid"}},
    {"id": "elevated copies", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${w1}"}}, {"elementId": {"guid": "${w2}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.zCoordinate", "approx": 3, "tol": 1e-6},
                {"path": "detailsOfElements[1].details.zCoordinate", "approx": 6, "tol": 1e-6}]}
  ],
  "teardown": [
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${wcopy}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${m1}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${m2}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${m3}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${rot1}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${rot2}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${w1}"}}]}},
    {"command": "DeleteElements", "params": {"elements": [{"elementId": {"guid": "${w2}"}}]}}
  ]
}
