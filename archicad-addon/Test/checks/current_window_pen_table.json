{
  "title": "SetCurrentPenTable puts a pen table into effect in the current window only",
  "minTapir": "1.7.4",
  "minArchicad": "27",
  "steps": [
    {"id": "floor plan", "command": "ChangeWindow", "creates": false,
     "params": {"windowType": "FloorPlan", "storyIndex": 0},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read the floor plan's", "command": "GetCurrentPenTable", "creates": false,
     "save": {"orig": "attributeId.guid"}},
    {"id": "list pen tables", "command": "GetAttributesByType", "creates": false,
     "params": {"attributeType": "PenTable"},
     "save": {"first": "attributes[0].attributeId.guid", "firstIndex": "attributes[0].index",
              "secondName": "attributes[1].name", "secondIndex": "attributes[1].index"}},
    {"id": "by attributeId", "command": "SetCurrentPenTable", "creates": false,
     "params": {"attributeId": {"guid": "${first}"}},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read back the first", "command": "GetCurrentPenTable", "creates": false,
     "save": {"now1": "index"},
     "expect": [{"expr": "${now1} - ${firstIndex}", "eq": 0, "name": "the pen table in effect"},
                {"path": "isPenTableAttribute", "eq": true}]},
    {"id": "flagged in effect", "command": "GetPenTables", "creates": false,
     "params": {"attributeIds": [{"attributeId": {"guid": "${first}"}}], "fields": ["isActiveForModel"]},
     "expect": [{"path": "penTables[0].isActiveForModel", "eq": true}]},
    {"id": "by name", "command": "SetCurrentPenTable", "creates": false,
     "params": {"name": "${secondName}"},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read back the second", "command": "GetCurrentPenTable", "creates": false,
     "save": {"now2": "index"},
     "expect": [{"expr": "${now2} - ${secondIndex}", "eq": 0, "name": "the pen table in effect"}]},
    {"id": "the window is still the floor plan", "command": "GetCurrentWindowType", "creates": false,
     "expect": [{"path": "currentWindowType", "eq": "FloorPlan"}]},
    {"id": "unknown name", "command": "SetCurrentPenTable", "creates": false,
     "params": {"name": "TapirCheck no such pen table"},
     "expect": [{"path": "success", "eq": false}]},
    {"id": "unknown attributeId", "command": "SetCurrentPenTable", "creates": false,
     "params": {"attributeId": {"guid": "00000000-0000-0000-0000-00000000BEEF"}},
     "expect": [{"path": "success", "eq": false}]},
    {"id": "refusals kept it", "command": "GetCurrentPenTable", "creates": false,
     "save": {"now3": "index"},
     "expect": [{"expr": "${now3} - ${secondIndex}", "eq": 0}]},
    {"id": "3D window", "command": "ChangeWindow", "creates": false,
     "params": {"windowType": "3DModel"},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read the 3D window's", "command": "GetCurrentPenTable", "creates": false,
     "save": {"orig3D": "attributeId.guid"}},
    {"id": "set the 3D window's", "command": "SetCurrentPenTable", "creates": false,
     "params": {"attributeId": {"guid": "${first}"}},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read back the 3D window's", "command": "GetCurrentPenTable", "creates": false,
     "save": {"now3D": "index"},
     "expect": [{"expr": "${now3D} - ${firstIndex}", "eq": 0}]},
    {"id": "still the 3D window", "command": "GetCurrentWindowType", "creates": false,
     "expect": [{"path": "currentWindowType", "eq": "3DModel"}]},
    {"id": "back to the floor plan", "command": "ChangeWindow", "creates": false,
     "params": {"windowType": "FloorPlan", "storyIndex": 0}},
    {"id": "the floor plan kept its own", "command": "GetCurrentPenTable", "creates": false,
     "save": {"now4": "index"},
     "expect": [{"expr": "${now4} - ${secondIndex}", "eq": 0, "name": "the 3D window change did not reach the floor plan"}]}
  ],
  "teardown": [
    {"command": "ChangeWindow", "params": {"windowType": "3DModel"}},
    {"command": "SetCurrentPenTable", "params": {"attributeId": {"guid": "${orig3D}"}}},
    {"command": "ChangeWindow", "params": {"windowType": "FloorPlan", "storyIndex": 0}},
    {"command": "SetCurrentPenTable", "params": {"attributeId": {"guid": "${orig}"}}}
  ]
}
