{
  "title": "ModifyLines, ModifyArcs, ModifyCircles and ModifyPolylines change the elements in place",
  "minTapir": "1.7.4",
  "steps": [
    {"id": "line", "command": "CreateLineElements",
     "params": {"linesData": [{"begCoordinate": {"x": 900, "y": 900}, "endCoordinate": {"x": 905, "y": 900}}]},
     "save": {"line": "elements[0].elementId.guid"}},
    {"id": "arc", "command": "CreateArcs",
     "params": {"arcsData": [{"origin": {"x": 910, "y": 900}, "radius": 2, "begAngle": 0, "endAngle": 1.5}]},
     "save": {"arc": "elements[0].elementId.guid"}},
    {"id": "circle", "command": "CreateCircles",
     "params": {"circlesData": [{"origin": {"x": 920, "y": 900}, "radius": 1}]},
     "save": {"circle": "elements[0].elementId.guid"}},
    {"id": "polyline", "command": "CreatePolylines",
     "params": {"polylinesData": [{"coordinates": [{"x": 900, "y": 910}, {"x": 905, "y": 910}, {"x": 905, "y": 915}]}]},
     "save": {"polyline": "elements[0].elementId.guid"}},
    {"id": "a link from the line", "command": "LinkElements", "creates": false,
     "params": {"links": [{"fromElementId": {"guid": "${line}"}, "toElementId": {"guid": "${arc}"}}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "a line type", "command": "API.GetAttributesByType", "creates": false,
     "params": {"attributeType": "Line"},
     "save": {"lineType": "attributeIds[2].attributeId.guid"}},

    {"id": "modify the line", "command": "ModifyLines", "creates": false,
     "params": {"linesWithDetails": [{"elementId": {"guid": "${line}"}, "begCoordinate": {"x": 901, "y": 901}, "endCoordinate": {"x": 907, "y": 903},
                                      "linePenIndex": 20, "lineTypeId": {"guid": "${lineType}"}, "roomSeparator": true}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "the same line, changed", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${line}"}}]},
     "expect": [{"path": "detailsOfElements[0].type", "eq": "Line", "name": "the GUID still names the line"},
                {"path": "detailsOfElements[0].details.begCoordinate.x", "approx": 901},
                {"path": "detailsOfElements[0].details.begCoordinate.y", "approx": 901},
                {"path": "detailsOfElements[0].details.endCoordinate.x", "approx": 907},
                {"path": "detailsOfElements[0].details.endCoordinate.y", "approx": 903},
                {"path": "detailsOfElements[0].details.linePenIndex", "eq": 20},
                {"path": "detailsOfElements[0].details.lineTypeId.guid", "exists": true},
                {"path": "detailsOfElements[0].details.roomSeparator", "eq": true}]},
    {"id": "the link is kept", "command": "GetLinksOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${line}"}}]},
     "expect": [{"path": "linksOfElements[0].links", "len": 1}]},

    {"id": "modify the arc", "command": "ModifyArcs", "creates": false,
     "params": {"arcsWithDetails": [{"elementId": {"guid": "${arc}"}, "origin": {"x": 911, "y": 901}, "radius": 3, "begAngle": 0.5, "endAngle": 2.5,
                                     "ratio": 2, "angle": 0.3, "linePenIndex": 5}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "the same arc, changed", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${arc}"}}]},
     "expect": [{"path": "detailsOfElements[0].type", "eq": "Arc"},
                {"path": "detailsOfElements[0].details.origin.x", "approx": 911},
                {"path": "detailsOfElements[0].details.radius", "approx": 3},
                {"path": "detailsOfElements[0].details.begAngle", "approx": 0.5},
                {"path": "detailsOfElements[0].details.endAngle", "approx": 2.5},
                {"path": "detailsOfElements[0].details.ratio", "approx": 2},
                {"path": "detailsOfElements[0].details.angle", "approx": 0.3},
                {"path": "detailsOfElements[0].details.linePenIndex", "eq": 5}]},

    {"id": "modify the circle", "command": "ModifyCircles", "creates": false,
     "params": {"circlesWithDetails": [{"elementId": {"guid": "${circle}"}, "origin": {"x": 921, "y": 902}, "radius": 4}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "the same circle, changed", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${circle}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.origin.x", "approx": 921},
                {"path": "detailsOfElements[0].details.origin.y", "approx": 902},
                {"path": "detailsOfElements[0].details.radius", "approx": 4}]},

    {"id": "modify the polyline", "command": "ModifyPolylines", "creates": false,
     "params": {"polylinesWithDetails": [{"elementId": {"guid": "${polyline}"},
                                          "coordinates": [{"x": 900, "y": 910}, {"x": 904, "y": 910}, {"x": 904, "y": 914}, {"x": 900, "y": 914}, {"x": 900, "y": 910}],
                                          "arcs": [{"begIndex": 1, "endIndex": 2, "arcAngle": 1.0}], "linePenIndex": 7}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "the same polyline, changed", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${polyline}"}}]},
     "expect": [{"path": "detailsOfElements[0].type", "eq": "PolyLine"},
                {"path": "detailsOfElements[0].details.coordinates", "len": 5},
                {"path": "detailsOfElements[0].details.coordinates[2].x", "approx": 904},
                {"path": "detailsOfElements[0].details.coordinates[2].y", "approx": 914},
                {"path": "detailsOfElements[0].details.arcs[0].begIndex", "eq": 1},
                {"path": "detailsOfElements[0].details.arcs[0].arcAngle", "approx": 1.0},
                {"path": "detailsOfElements[0].details.linePenIndex", "eq": 7}]},

    {"id": "wrong element type", "command": "ModifyLines", "creates": false,
     "params": {"linesWithDetails": [{"elementId": {"guid": "${arc}"}, "linePenIndex": 3}]},
     "expect": [{"path": "executionResults[0].success", "eq": false}]},
    {"id": "nothing to change", "command": "ModifyLines", "creates": false,
     "params": {"linesWithDetails": [{"elementId": {"guid": "${line}"}}]},
     "expect": [{"path": "executionResults[0].success", "eq": false}]},
    {"id": "arcs without coordinates", "command": "ModifyPolylines", "creates": false,
     "params": {"polylinesWithDetails": [{"elementId": {"guid": "${polyline}"}, "arcs": []}]},
     "expect": [{"path": "executionResults[0].success", "eq": false}]}
  ]
}
