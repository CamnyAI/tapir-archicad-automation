{
  "title": "IntersectElements and AdjustElements extend or trim straight walls, beams and lines",
  "minTapir": "1.7.4",
  "steps": [
    {"id": "two lines that do not meet", "command": "CreateLineElements",
     "params": {"linesData": [{"begCoordinate": {"x": 700, "y": 700}, "endCoordinate": {"x": 704, "y": 700}},
                              {"begCoordinate": {"x": 706, "y": 701}, "endCoordinate": {"x": 706, "y": 705}},
                              {"begCoordinate": {"x": 700, "y": 720}, "endCoordinate": {"x": 704, "y": 720}},
                              {"begCoordinate": {"x": 700, "y": 722}, "endCoordinate": {"x": 704, "y": 722}}]},
     "save": {"l1": "elements[0].elementId.guid", "l2": "elements[1].elementId.guid", "p1": "elements[2].elementId.guid", "p2": "elements[3].elementId.guid"}},
    {"id": "two crossing walls", "command": "CreateWalls",
     "params": {"wallsData": [{"begCoordinate": {"x": 700, "y": 710}, "endCoordinate": {"x": 708, "y": 710}, "zCoordinate": 0, "height": 3, "thickness": 0.3},
                              {"begCoordinate": {"x": 705, "y": 708}, "endCoordinate": {"x": 705, "y": 715}, "zCoordinate": 0, "height": 3, "thickness": 0.3}]},
     "save": {"w1": "elements[0].elementId.guid", "w2": "elements[1].elementId.guid"}},
    {"id": "intersect", "command": "IntersectElements", "creates": false,
     "params": {"elementPairs": [{"elementId1": {"guid": "${l1}"}, "elementId2": {"guid": "${l2}"}},
                                 {"elementId1": {"guid": "${w1}"}, "elementId2": {"guid": "${w2}"}},
                                 {"elementId1": {"guid": "${p1}"}, "elementId2": {"guid": "${p2}"}}]},
     "expect": [{"path": "executionResults[0].success", "eq": true},
                {"path": "executionResults[1].success", "eq": true},
                {"path": "executionResults[2].success", "eq": false, "name": "parallel lines have no intersection"}]},
    {"id": "intersected lines and walls", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${l1}"}}, {"elementId": {"guid": "${l2}"}}, {"elementId": {"guid": "${w1}"}}, {"elementId": {"guid": "${w2}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.endCoordinate.x", "approx": 706, "tol": 1e-6, "name": "line 1 extended to x = 706"},
                {"path": "detailsOfElements[1].details.begCoordinate.y", "approx": 700, "tol": 1e-6, "name": "line 2 extended down to y = 700"},
                {"path": "detailsOfElements[1].details.endCoordinate.y", "approx": 705, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.begCoordinate.x", "approx": 700, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.endCoordinate.x", "approx": 705, "tol": 1e-6, "name": "wall 1 trimmed at the crossing"},
                {"path": "detailsOfElements[3].details.begCoordinate.y", "approx": 710, "tol": 1e-6, "name": "wall 2 trimmed at the crossing"},
                {"path": "detailsOfElements[3].details.endCoordinate.y", "approx": 715, "tol": 1e-6}]},
    {"id": "lines and a wall around x = 730", "command": "CreateLineElements",
     "params": {"linesData": [{"begCoordinate": {"x": 720, "y": 730}, "endCoordinate": {"x": 725, "y": 730}},
                              {"begCoordinate": {"x": 735, "y": 732}, "endCoordinate": {"x": 740, "y": 732}},
                              {"begCoordinate": {"x": 750, "y": 730}, "endCoordinate": {"x": 750, "y": 740}},
                              {"begCoordinate": {"x": 742, "y": 735}, "endCoordinate": {"x": 745, "y": 735}}]},
     "save": {"j1": "elements[0].elementId.guid", "j2": "elements[1].elementId.guid", "t": "elements[2].elementId.guid", "j3": "elements[3].elementId.guid"}},
    {"id": "wall across x = 730", "command": "CreateWalls",
     "params": {"wallsData": [{"begCoordinate": {"x": 720, "y": 734}, "endCoordinate": {"x": 735, "y": 734}, "zCoordinate": 0, "height": 3, "thickness": 0.3}]},
     "save": {"jw": "elements[0].elementId.guid"}},
    {"id": "adjust to the line x = 730", "command": "AdjustElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${j1}"}}, {"elementId": {"guid": "${j2}"}}, {"elementId": {"guid": "${jw}"}}],
                "targetLine": {"begCoordinate": {"x": 730, "y": 0}, "endCoordinate": {"x": 730, "y": 1}}},
     "expect": [{"path": "executionResults[0].success", "eq": true},
                {"path": "executionResults[1].success", "eq": true},
                {"path": "executionResults[2].success", "eq": true}]},
    {"id": "adjust to a target element", "command": "AdjustElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${j3}"}}, {"elementId": {"guid": "${t}"}}], "targetElementId": {"guid": "${t}"}},
     "expect": [{"path": "executionResults[0].success", "eq": true},
                {"path": "executionResults[1].success", "eq": false, "name": "the target itself is not adjusted"}]},
    {"id": "adjusted elements", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${j1}"}}, {"elementId": {"guid": "${j2}"}}, {"elementId": {"guid": "${jw}"}}, {"elementId": {"guid": "${j3}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.endCoordinate.x", "approx": 730, "tol": 1e-6, "name": "extended to the target"},
                {"path": "detailsOfElements[1].details.begCoordinate.x", "approx": 730, "tol": 1e-6, "name": "extended back to the target"},
                {"path": "detailsOfElements[1].details.endCoordinate.x", "approx": 740, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.begCoordinate.x", "approx": 720, "tol": 1e-6},
                {"path": "detailsOfElements[2].details.endCoordinate.x", "approx": 730, "tol": 1e-6, "name": "the wall is trimmed at the target"},
                {"path": "detailsOfElements[3].details.endCoordinate.x", "approx": 750, "tol": 1e-6, "name": "extended to the target line element"}]}
  ]
}
