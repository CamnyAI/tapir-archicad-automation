{
  "title": "CreateDetailMarkers and CreateWorksheetMarkers: source markers with their new databases",
  "minTapir": "1.7.4",
  "requiresEmpty": [
    "Wall",
    "Detail",
    "Worksheet"
  ],
  "steps": [
    {
      "id": "wall",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          {
            "begCoordinate": {
              "x": 900,
              "y": 900
            },
            "endCoordinate": {
              "x": 905,
              "y": 900
            },
            "zCoordinate": 0,
            "height": 3,
            "thickness": 0.3
          }
        ]
      }
    },
    {
      "id": "source detail marker",
      "command": "CreateDetailMarkers",
      "params": {
        "detailMarkersData": [
          {
            "position": {
              "x": 900,
              "y": 900
            },
            "name": "TapirCheck detail",
            "referenceId": "TC-D1",
            "polygonCoordinates": [
              {
                "x": 899,
                "y": 898
              },
              {
                "x": 906,
                "y": 898
              },
              {
                "x": 906,
                "y": 902
              },
              {
                "x": 899,
                "y": 902
              }
            ],
            "markerPosition": {
              "x": 907,
              "y": 903
            }
          }
        ]
      },
      "save": {
        "d1": "elements[0].elementId.guid"
      }
    },
    {
      "id": "source detail marker read back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${d1}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "detailsOfElements[0].type",
          "eq": "Detail"
        },
        {
          "path": "detailsOfElements[0].details.detailName",
          "eq": "TapirCheck detail"
        },
        {
          "path": "detailsOfElements[0].details.detailIdStr",
          "eq": "TC-D1"
        },
        {
          "path": "detailsOfElements[0].details.basePoint.x",
          "approx": 902.5,
          "tol": 0.0001,
          "name": "reference point at the center of the polygon"
        },
        {
          "path": "detailsOfElements[0].details.clipPolygon[0].x",
          "approx": 899,
          "tol": 0.0001,
          "name": "the polygon"
        }
      ]
    },
    {
      "id": "detail marker without a polygon",
      "command": "CreateDetailMarkers",
      "params": {
        "detailMarkersData": [
          {
            "position": {
              "x": 910,
              "y": 900
            },
            "name": "TapirCheck detail 2",
            "referenceId": "TC-D2",
            "markerPosition": {
              "x": 912,
              "y": 901
            },
            "angle": 0.5
          }
        ]
      },
      "save": {
        "d2": "elements[0].elementId.guid"
      }
    },
    {
      "id": "detail marker without a polygon read back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${d2}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "detailsOfElements[0].details.basePoint.x",
          "approx": 910,
          "tol": 0.0001,
          "name": "reference point at position"
        },
        {
          "path": "detailsOfElements[0].details.angle",
          "approx": 0.5,
          "tol": 0.0001
        },
        {
          "path": "detailsOfElements[0].details.clipPolygon",
          "len": 0
        }
      ]
    },
    {
      "id": "linking is not offered",
      "command": "CreateDetailMarkers",
      "creates": false,
      "allowEnvelopeError": true,
      "params": {
        "detailMarkersData": [
          {
            "position": {
              "x": 920,
              "y": 900
            },
            "linkedNavigatorItemId": {
              "guid": "00000000-0000-0000-0000-00000000BEEF"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "elements",
          "exists": false
        }
      ]
    },
    {
      "id": "source worksheet marker",
      "command": "CreateWorksheetMarkers",
      "params": {
        "worksheetMarkersData": [
          {
            "position": {
              "x": 900,
              "y": 910
            },
            "name": "TapirCheck worksheet",
            "referenceId": "TC-W1",
            "polygonCoordinates": [
              {
                "x": 899,
                "y": 898
              },
              {
                "x": 906,
                "y": 898
              },
              {
                "x": 906,
                "y": 902
              },
              {
                "x": 899,
                "y": 902
              }
            ]
          }
        ]
      },
      "save": {
        "w1": "elements[0].elementId.guid"
      }
    },
    {
      "id": "source worksheet marker read back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${w1}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "detailsOfElements[0].type",
          "eq": "Worksheet"
        },
        {
          "path": "detailsOfElements[0].details.detailName",
          "eq": "TapirCheck worksheet"
        },
        {
          "path": "detailsOfElements[0].details.clipPolygon[2].y",
          "approx": 902,
          "tol": 0.0001,
          "name": "the polygon"
        }
      ]
    },
    {
      "id": "the new worksheet database",
      "command": "GetDatabases",
      "creates": false,
      "params": {
        "types": [
          "Worksheet"
        ]
      },
      "expect": [
        {
          "path": "databases[0].name",
          "eq": "TapirCheck worksheet"
        },
        {
          "path": "databases[0].referenceId",
          "eq": "TC-W1"
        }
      ]
    }
  ]
}
