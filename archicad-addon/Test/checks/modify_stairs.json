{
  "title": "ModifyStairs changes the width, the risers, the heights and the elevation of a stair in place",
  "minTapir": "1.7.4",
  "steps": [
    {"id": "stair", "command": "CreateStairs",
     "params": {"stairsData": [{"baseLinePoints": [{"x": 980, "y": 950}, {"x": 986, "y": 950}], "zCoordinate": 0, "totalHeight": 3.0, "stepNum": 20, "flightWidth": 1.2}]},
     "save": {"stair": "elements[0].elementId.guid"}},
    {"id": "as created", "command": "GetDetailsOfElements", "creates": false, "stopOnFail": true,
     "params": {"elements": [{"elementId": {"guid": "${stair}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.stepNum", "eq": 20},
                {"path": "detailsOfElements[0].details.totalHeight", "approx": 3.0}]},

    {"id": "width and id", "command": "ModifyStairs", "creates": false,
     "params": {"stairsWithDetails": [{"elementId": {"guid": "${stair}"}, "flightWidth": 1.5, "id": "S-CHECK"}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "wider", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${stair}"}}]},
     "expect": [{"path": "detailsOfElements[0].type", "eq": "Stair"},
                {"path": "detailsOfElements[0].id", "eq": "S-CHECK"},
                {"path": "detailsOfElements[0].details.flightWidth", "approx": 1.5},
                {"path": "detailsOfElements[0].details.stepNum", "eq": 20}]},

    {"id": "fewer risers", "command": "ModifyStairs", "creates": false,
     "params": {"stairsWithDetails": [{"elementId": {"guid": "${stair}"}, "stepNum": 18}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "higher risers", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${stair}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.stepNum", "eq": 18},
                {"path": "detailsOfElements[0].details.riserHeight", "approx": 0.1666667, "tol": 1e-5},
                {"path": "detailsOfElements[0].details.totalHeight", "approx": 3.0}]},

    {"id": "lower stair", "command": "ModifyStairs", "creates": false,
     "params": {"stairsWithDetails": [{"elementId": {"guid": "${stair}"}, "totalHeight": 2.7}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "same risers, lower", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${stair}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.totalHeight", "approx": 2.7},
                {"path": "detailsOfElements[0].details.stepNum", "eq": 18},
                {"path": "detailsOfElements[0].details.riserHeight", "approx": 0.15, "tol": 1e-5}]},

    {"id": "riser height", "command": "ModifyStairs", "creates": false,
     "params": {"stairsWithDetails": [{"elementId": {"guid": "${stair}"}, "riserHeight": 0.17}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "the closest number of risers", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${stair}"}}]},
     "expect": [{"path": "detailsOfElements[0].details.stepNum", "eq": 16},
                {"path": "detailsOfElements[0].details.riserHeight", "approx": 0.16875, "tol": 1e-5},
                {"path": "detailsOfElements[0].details.totalHeight", "approx": 2.7}]},

    {"id": "raised base", "command": "ModifyStairs", "creates": false,
     "params": {"stairsWithDetails": [{"elementId": {"guid": "${stair}"}, "zCoordinate": 0.4}]},
     "expect": [{"path": "executionResults[0].success", "eq": true}]},
    {"id": "at the new elevation", "command": "GetDetailsOfElements", "creates": false,
     "params": {"elements": [{"elementId": {"guid": "${stair}"}}]},
     "expect": [{"path": "detailsOfElements[0].floorIndex", "eq": 0},
                {"path": "detailsOfElements[0].details.level", "approx": 0.4},
                {"path": "detailsOfElements[0].details.stepNum", "eq": 16, "name": "the risers stay"}]},

    {"id": "not a stair", "command": "CreateLineElements",
     "params": {"linesData": [{"begCoordinate": {"x": 980, "y": 940}, "endCoordinate": {"x": 985, "y": 940}}]},
     "save": {"line": "elements[0].elementId.guid"}},
    {"id": "refused for a line", "command": "ModifyStairs", "creates": false,
     "params": {"stairsWithDetails": [{"elementId": {"guid": "${line}"}, "flightWidth": 1.0}]},
     "expect": [{"path": "executionResults[0].success", "eq": false}]}
  ]
}
