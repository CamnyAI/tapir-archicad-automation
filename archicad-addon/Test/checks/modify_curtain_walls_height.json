{
  "title": "ModifyCurtainWalls changes the height of a curtain wall (#913)",
  "minTapir": "1.7.4",
  "steps": [
    {
      "id": "create a 6 m curtain wall, 3 m high, 1 m columns and rows",
      "command": "CreateCurtainWalls",
      "params": {
        "curtainWallsData": [
          {
            "coordinates": [
              {
                "x": 900,
                "y": 900
              },
              {
                "x": 906,
                "y": 900
              }
            ],
            "zCoordinate": 0,
            "floorIndex": 0,
            "height": 3.0,
            "primaryPattern": {
              "logic": "FixedSizes",
              "sizes": [
                1.0
              ]
            },
            "secondaryPattern": {
              "logic": "FixedSizes",
              "sizes": [
                1.0
              ]
            }
          }
        ]
      },
      "save": {
        "cw": "elements[0].elementId.guid"
      },
      "expect": [
        {
          "path": "elements[0].elementId.guid",
          "exists": true,
          "name": "created"
        }
      ]
    },
    {
      "id": "box at 3 m",
      "command": "Get3DBoundingBoxes",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${cw}"
            }
          }
        ]
      },
      "save": {
        "zMin0": "boundingBoxes3D[0].boundingBox3D.zMin",
        "zMax0": "boundingBoxes3D[0].boundingBox3D.zMax",
        "xMin0": "boundingBoxes3D[0].boundingBox3D.xMin",
        "xMax0": "boundingBoxes3D[0].boundingBox3D.xMax"
      }
    },
    {
      "id": "6 x 3 panels",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${cw}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "subelements[0].cWallPanels",
          "len": 18,
          "name": "18 panels: 6 columns x 3 rows"
        }
      ]
    },
    {
      "id": "height 4 m",
      "command": "ModifyCurtainWalls",
      "creates": false,
      "params": {
        "curtainWallsWithDetails": [
          {
            "elementId": {
              "guid": "${cw}"
            },
            "height": 4.0
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true,
          "name": "succeeds"
        }
      ]
    },
    {
      "id": "box after 4 m",
      "command": "Get3DBoundingBoxes",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${cw}"
            }
          }
        ]
      },
      "save": {
        "zMin1": "boundingBoxes3D[0].boundingBox3D.zMin",
        "zMax1": "boundingBoxes3D[0].boundingBox3D.zMax",
        "xMin1": "boundingBoxes3D[0].boundingBox3D.xMin",
        "xMax1": "boundingBoxes3D[0].boundingBox3D.xMax"
      }
    },
    {
      "id": "4 m read back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${cw}"
            }
          }
        ]
      },
      "expect": [
        {
          "expr": "${zMax1} - ${zMin1}",
          "approx": 4.0,
          "tol": 0.01,
          "name": "3D box is 4 m high"
        },
        {
          "expr": "${zMin1} - ${zMin0}",
          "approx": 0.0,
          "tol": 0.001,
          "name": "bottom stays"
        },
        {
          "expr": "(${xMax1} - ${xMin1}) - (${xMax0} - ${xMin0})",
          "approx": 0.0,
          "tol": 0.001,
          "name": "length stays"
        },
        {
          "path": "detailsOfElements[0].details.actualHeight",
          "approx": 4.0,
          "tol": 0.001,
          "name": "actualHeight is 4 m"
        }
      ]
    },
    {
      "id": "6 x 4 panels",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${cw}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "subelements[0].cWallPanels",
          "len": 24,
          "name": "24 panels: the rows fill the new height"
        }
      ]
    },
    {
      "id": "height 2 m",
      "command": "ModifyCurtainWalls",
      "creates": false,
      "params": {
        "curtainWallsWithDetails": [
          {
            "elementId": {
              "guid": "${cw}"
            },
            "height": 2.0
          }
        ]
      },
      "expect": [
        {
          "path": "executionResults[0].success",
          "eq": true,
          "name": "succeeds"
        }
      ]
    },
    {
      "id": "box after 2 m",
      "command": "Get3DBoundingBoxes",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${cw}"
            }
          }
        ]
      },
      "save": {
        "zMin2": "boundingBoxes3D[0].boundingBox3D.zMin",
        "zMax2": "boundingBoxes3D[0].boundingBox3D.zMax",
        "xMin2": "boundingBoxes3D[0].boundingBox3D.xMin",
        "xMax2": "boundingBoxes3D[0].boundingBox3D.xMax"
      }
    },
    {
      "id": "2 m read back",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${cw}"
            }
          }
        ]
      },
      "expect": [
        {
          "expr": "${zMax2} - ${zMin2}",
          "approx": 2.0,
          "tol": 0.01,
          "name": "3D box is 2 m high"
        },
        {
          "path": "detailsOfElements[0].details.actualHeight",
          "approx": 2.0,
          "tol": 0.001,
          "name": "actualHeight is 2 m"
        }
      ]
    },
    {
      "id": "6 x 2 panels",
      "command": "GetSubelementsOfHierarchicalElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${cw}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "subelements[0].cWallPanels",
          "len": 12,
          "name": "12 panels"
        }
      ]
    }
  ]
}
