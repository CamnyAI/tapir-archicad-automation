{
  "title": "Model view options of the current window: switch by name, single settings, back to a combination, per window",
  "minTapir": "1.7.4",
  "minArchicad": "27",
  "steps": [
    {"id": "floor plan", "command": "ChangeWindow", "creates": false,
     "params": {"windowType": "FloorPlan", "storyIndex": 0},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read the floor plan's", "command": "GetCurrentModelViewOption", "creates": false,
     "save": {"orig": "name"},
     "expect": [{"path": "index", "gt": 0},
                {"path": "settings.doorDisplay", "exists": true},
                {"path": "settings.hideZoneStamps", "exists": true}]},
    {"id": "list combinations", "command": "GetModelViewOptions", "creates": false,
     "save": {"firstName": "modelViewOptions[0].name", "secondName": "modelViewOptions[1].name"}},
    {"id": "find the first by name", "command": "FindModelViewOption", "creates": false,
     "params": {"name": "${firstName}"},
     "save": {"firstIndex": "index"},
     "expect": [{"path": "index", "gt": 0, "name": "FindModelViewOption finds a combination by name"}]},
    {"id": "switch to the first", "command": "SetCurrentModelViewOption", "creates": false,
     "params": {"name": "${firstName}"},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read back the first", "command": "GetCurrentModelViewOption", "creates": false,
     "save": {"now1": "index"},
     "expect": [{"expr": "${now1} - ${firstIndex}", "eq": 0, "name": "index of the combination switched to"},
                {"path": "matchesCombination", "eq": true}]},
    {"id": "switch to the second", "command": "SetCurrentModelViewOption", "creates": false,
     "params": {"name": "${secondName}"},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "find the second", "command": "FindModelViewOption", "creates": false,
     "params": {"name": "${secondName}"},
     "save": {"secondIndex": "index"}},
    {"id": "read back the second", "command": "GetCurrentModelViewOption", "creates": false,
     "save": {"now2": "index"},
     "expect": [{"expr": "${now2} - ${secondIndex}", "eq": 0, "name": "index of the combination switched to"},
                {"path": "matchesCombination", "eq": true}]},
    {"id": "single settings", "command": "SetCurrentModelViewOption", "creates": false,
     "params": {"settings": {"doorDisplay": "HideOnPlan", "windowDisplay": "HideOnPlan", "hideZoneStamps": true, "beamDisplay": "Contour"}},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read back the settings", "command": "GetCurrentModelViewOption", "creates": false,
     "expect": [{"path": "index", "eq": 0, "name": "custom settings have index 0"},
                {"path": "name", "exists": false},
                {"path": "settings.doorDisplay", "eq": "HideOnPlan"},
                {"path": "settings.windowDisplay", "eq": "HideOnPlan"},
                {"path": "settings.hideZoneStamps", "eq": true},
                {"path": "settings.beamDisplay", "eq": "Contour"}]},
    {"id": "list while custom", "command": "GetModelViewOptions", "creates": false,
     "expect": [{"path": "modelViewOptions[0].name", "ne": "", "name": "the window's custom settings are not listed as a combination"}]},
    {"id": "find while custom", "command": "FindModelViewOption", "creates": false,
     "params": {"name": "${secondName}"},
     "expect": [{"path": "index", "gt": 0},
                {"path": "name", "ne": "", "name": "FindModelViewOption finds the named combination while the window uses custom settings"}]},
    {"id": "other settings", "command": "SetCurrentModelViewOption", "creates": false,
     "params": {"settings": {"doorDisplay": "ShowOnPlan", "hideZoneStamps": false, "showColumnSymbols": false}},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read back the other settings", "command": "GetCurrentModelViewOption", "creates": false,
     "expect": [{"path": "settings.doorDisplay", "eq": "ShowOnPlan"},
                {"path": "settings.windowDisplay", "eq": "HideOnPlan", "name": "a setting not given is kept"},
                {"path": "settings.hideZoneStamps", "eq": false},
                {"path": "settings.showColumnSymbols", "eq": false}]},
    {"id": "back to the second, from custom settings made from it", "command": "SetCurrentModelViewOption", "creates": false,
     "params": {"name": "${secondName}"},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read back the second again", "command": "GetCurrentModelViewOption", "creates": false,
     "save": {"now3": "index"},
     "expect": [{"expr": "${now3} - ${secondIndex}", "eq": 0},
                {"path": "matchesCombination", "eq": true}]},
    {"id": "combination and a setting", "command": "SetCurrentModelViewOption", "creates": false,
     "params": {"name": "${firstName}", "settings": {"beamDisplay": "ReferenceLine"}},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read back combination and setting", "command": "GetCurrentModelViewOption", "creates": false,
     "expect": [{"path": "index", "eq": 0},
                {"path": "settings.beamDisplay", "eq": "ReferenceLine"}]},
    {"id": "unknown name", "command": "SetCurrentModelViewOption", "creates": false,
     "params": {"name": "TapirCheck no such combination"},
     "expect": [{"path": "success", "eq": false}]},
    {"id": "the refusal changed nothing", "command": "GetCurrentModelViewOption", "creates": false,
     "expect": [{"path": "index", "eq": 0},
                {"path": "settings.beamDisplay", "eq": "ReferenceLine"}]},
    {"id": "back to the first, from custom settings made from it", "command": "SetCurrentModelViewOption", "creates": false,
     "params": {"name": "${firstName}"},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read back the first again", "command": "GetCurrentModelViewOption", "creates": false,
     "save": {"now4": "index"},
     "expect": [{"expr": "${now4} - ${firstIndex}", "eq": 0},
                {"path": "matchesCombination", "eq": true}]},
    {"id": "3D window", "command": "ChangeWindow", "creates": false,
     "params": {"windowType": "3DModel"},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read the 3D window's", "command": "GetCurrentModelViewOption", "creates": false,
     "save": {"orig3D": "name"}},
    {"id": "switch the 3D window", "command": "SetCurrentModelViewOption", "creates": false,
     "params": {"name": "${secondName}"},
     "expect": [{"path": "success", "eq": true}]},
    {"id": "read back the 3D window's", "command": "GetCurrentModelViewOption", "creates": false,
     "save": {"now3D": "index"},
     "expect": [{"expr": "${now3D} - ${secondIndex}", "eq": 0}]},
    {"id": "back to the floor plan", "command": "ChangeWindow", "creates": false,
     "params": {"windowType": "FloorPlan", "storyIndex": 0}},
    {"id": "the floor plan kept its own", "command": "GetCurrentModelViewOption", "creates": false,
     "save": {"now5": "index"},
     "expect": [{"expr": "${now5} - ${firstIndex}", "eq": 0, "name": "the 3D window change did not reach the floor plan"}]}
  ],
  "teardown": [
    {"command": "ChangeWindow", "params": {"windowType": "3DModel"}},
    {"command": "SetCurrentModelViewOption", "params": {"name": "${orig3D}"}},
    {"command": "ChangeWindow", "params": {"windowType": "FloorPlan", "storyIndex": 0}},
    {"command": "SetCurrentModelViewOption", "params": {"name": "${orig}"}}
  ]
}
