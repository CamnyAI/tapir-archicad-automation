{
  "title": "GetElementChangesSince lists the created, moved and deleted wall since a ModificationStamp state",
  "minTapir": "1.7.4",
  "steps": [
    {
      "id": "state before the wall",
      "command": "CaptureElementState",
      "creates": false,
      "params": {
        "type": "ModificationStamp"
      },
      "save": {
        "s1": "stateId"
      },
      "expect": [
        {
          "path": "type",
          "eq": "ModificationStamp",
          "name": "captured with the type asked for"
        }
      ]
    },
    {
      "id": "new wall",
      "command": "CreateWalls",
      "params": {
        "wallsData": [
          {
            "begCoordinate": {
              "x": 700.0,
              "y": 700.0
            },
            "endCoordinate": {
              "x": 704.0,
              "y": 700.0
            },
            "zCoordinate": 0.0,
            "height": 3.0,
            "thickness": 0.3
          }
        ]
      },
      "save": {
        "w1": "elements[0].elementId.guid"
      }
    },
    {
      "id": "changes since the first state",
      "command": "GetElementChangesSince",
      "creates": false,
      "params": {
        "stateId": "${s1}"
      },
      "expect": [
        {
          "path": "newElements",
          "len": 1,
          "name": "one new element"
        },
        {
          "path": "modifiedElements",
          "len": 0,
          "name": "nothing modified"
        },
        {
          "path": "deletedElements",
          "len": 0,
          "name": "nothing deleted"
        }
      ],
      "save": {
        "listedNew": "newElements[0].elementId.guid"
      }
    },
    {
      "id": "the listed element is the new wall",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${listedNew}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "detailsOfElements[0].type",
          "eq": "Wall",
          "name": "a wall"
        },
        {
          "path": "detailsOfElements[0].details.begCoordinate.x",
          "approx": 700.0,
          "tol": 0.001,
          "name": "the check's wall"
        },
        {
          "path": "detailsOfElements[0].details.begCoordinate.y",
          "approx": 700.0,
          "tol": 0.001,
          "name": "where it was created"
        }
      ]
    },
    {
      "id": "state with the wall",
      "command": "CaptureElementState",
      "creates": false,
      "params": {
        "type": "ModificationStamp"
      },
      "save": {
        "s2": "stateId"
      }
    },
    {
      "id": "move the wall",
      "command": "MoveElements",
      "creates": false,
      "params": {
        "elementsWithMoveVectors": [
          {
            "elementId": {
              "guid": "${w1}"
            },
            "moveVector": {
              "x": 0.0,
              "y": 1.0,
              "z": 0.0
            }
          }
        ]
      }
    },
    {
      "id": "changes since the second state",
      "command": "GetElementChangesSince",
      "creates": false,
      "params": {
        "stateId": "${s2}"
      },
      "expect": [
        {
          "path": "newElements",
          "len": 0,
          "name": "nothing new"
        },
        {
          "path": "modifiedElements",
          "len": 1,
          "name": "one modified element"
        },
        {
          "path": "deletedElements",
          "len": 0,
          "name": "nothing deleted"
        }
      ],
      "save": {
        "listedModified": "modifiedElements[0].elementId.guid"
      }
    },
    {
      "id": "the listed element is the moved wall",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${listedModified}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "detailsOfElements[0].type",
          "eq": "Wall",
          "name": "a wall"
        },
        {
          "path": "detailsOfElements[0].details.begCoordinate.x",
          "approx": 700.0,
          "tol": 0.001,
          "name": "the check's wall"
        },
        {
          "path": "detailsOfElements[0].details.begCoordinate.y",
          "approx": 701.0,
          "tol": 0.001,
          "name": "after the move"
        }
      ]
    },
    {
      "id": "between the first two states",
      "command": "GetElementChangesSince",
      "creates": false,
      "params": {
        "stateId": "${s1}",
        "toStateId": "${s2}"
      },
      "expect": [
        {
          "path": "newElements",
          "len": 1,
          "name": "one new element"
        },
        {
          "path": "deletedElements",
          "len": 0,
          "name": "nothing deleted between them"
        }
      ],
      "save": {
        "listedBetween": "newElements[0].elementId.guid"
      }
    },
    {
      "id": "the listed element is the wall, moved since",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${listedBetween}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "detailsOfElements[0].type",
          "eq": "Wall",
          "name": "a wall"
        },
        {
          "path": "detailsOfElements[0].details.begCoordinate.x",
          "approx": 700.0,
          "tol": 0.001,
          "name": "the check's wall"
        },
        {
          "path": "detailsOfElements[0].details.begCoordinate.y",
          "approx": 701.0,
          "tol": 0.001,
          "name": "after the move"
        }
      ]
    },
    {
      "id": "state with the moved wall",
      "command": "CaptureElementState",
      "creates": false,
      "params": {},
      "save": {
        "s3": "stateId"
      },
      "expect": [
        {
          "path": "type",
          "eq": "ModificationStamp",
          "name": "ModificationStamp is the default type"
        }
      ]
    },
    {
      "id": "delete the wall",
      "command": "DeleteElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${w1}"
            }
          }
        ]
      }
    },
    {
      "id": "changes since the third state",
      "command": "GetElementChangesSince",
      "creates": false,
      "params": {
        "stateId": "${s3}"
      },
      "expect": [
        {
          "path": "newElements",
          "len": 0,
          "name": "nothing new"
        },
        {
          "path": "modifiedElements",
          "len": 0,
          "name": "nothing modified"
        },
        {
          "path": "deletedElements",
          "len": 1,
          "name": "one deleted element"
        }
      ],
      "save": {
        "listedDeleted": "deletedElements[0].elementId.guid"
      }
    },
    {
      "id": "the listed element is gone",
      "command": "GetDetailsOfElements",
      "creates": false,
      "params": {
        "elements": [
          {
            "elementId": {
              "guid": "${listedDeleted}"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "detailsOfElements[0].error",
          "exists": true,
          "name": "deleted from the project"
        }
      ]
    },
    {
      "id": "release the first state",
      "command": "ReleaseElementState",
      "creates": false,
      "params": {
        "stateId": "${s1}"
      },
      "expect": [
        {
          "path": "success",
          "eq": true,
          "name": "released"
        }
      ]
    },
    {
      "id": "a released state is unknown",
      "command": "GetElementChangesSince",
      "creates": false,
      "params": {
        "stateId": "${s1}"
      },
      "expect": [
        {
          "path": "error.message",
          "contains": "Unknown stateId",
          "name": "rejected"
        }
      ]
    }
  ],
  "teardown": [
    {
      "command": "ReleaseElementState",
      "params": {
        "stateId": "${s1}"
      }
    },
    {
      "command": "ReleaseElementState",
      "params": {
        "stateId": "${s2}"
      }
    },
    {
      "command": "ReleaseElementState",
      "params": {
        "stateId": "${s3}"
      }
    }
  ]
}
